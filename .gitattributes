# Auto detect text files and perform LF normalization
* text=auto

# Git LFS for binaries
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.mvba filter=lfs diff=lfs merge=lfs -text

# VBA extensions: Prevent LF normalization (VBE requires CRLF)
*.bas -text
*.cls -text
*.frm -text
# A .frx is a UserForm's binary layout blob. It survives "* text=auto" only because it happens to hold
# NUL bytes; one that did not would be silently mangled on checkout, and the form with it.
*.frx binary

# Force binary for these files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary